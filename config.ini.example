; Configuration template for RunBackup.bat
; COPY this file to config.ini and replace the values with your actual paths.

; The drive letter of your backup destination (e.g., Z:, E:)
TARGET_DRIVE=Z:

; The exact folder where backups should be stored
BACKUP_PATH=Z:\backups\Your_PC_Name\C

; Path to the FreeFileSync executable
FFS_EXE=C:\Program Files\FreeFileSync\FreeFileSync.exe

; Path to your FreeFileSync batch run configuration (.ffs_batch)
FFS_BATCH=C:\path\to\your\Sync_Config.ffs_batch

; Minimum number of days to wait between backups
BACKUP_INTERVAL=6